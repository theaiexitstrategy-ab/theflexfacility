{
  "rewrites": [
    { "source": "/fit", "destination": "/index7.html" },
    { "source": "/thank-you", "destination": "/thank-you.html" },
    { "source": "/ebook", "destination": "/ebook-order-page.html" },
    { "source": "/r2s", "destination": "/r2s.html" },
    { "source": "/r2s-thank-you", "destination": "/r2s-thank-you.html" },
    { "source": "/dl/r2s-program", "destination": "/road_to_the_stage.pdf" },
    { "source": "/trainers", "destination": "/trainers.html" },
    { "source": "/merch", "destination": "/merch.html" },
    { "source": "/bootcamp", "destination": "/bootcamp.html" },
    { "source": "/bootcamp-thank-you", "destination": "/bootcamp-thank-you.html" },
    { "source": "/privacy", "destination": "/privacy.html" },
    { "source": "/terms", "destination": "/terms.html" },
    { "source": "/fuel/agent", "destination": "/fuel-agent.html" },
    { "source": "/fuel/agent/me", "destination": "/fuel-agent-me.html" },
    { "source": "/fuel/agent/rules", "destination": "/fuel-agent-rules.html" },
    { "source": "/reviews", "destination": "/reviews.html" },
    { "source": "/about", "destination": "/about.html" },
    { "source": "/manual", "destination": "/manual.html" }
  ],
  "functions": {
    "api/fuel-challenge.js": {
      "maxDuration": 60,
      "includeFiles": "node_modules/@contentauth/c2pa-node/dist/index.node"
    }
  },
  "crons": [
    { "path": "/api/fuel-challenge?action=cron-daily", "schedule": "0 6 * * *" }
  ],
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "portal.theflexfacility.com" }],
      "destination": "https://portal.goelev8.ai/:path*",
      "permanent": true
    },
    { "source": "/fuel", "destination": "https://fuel.theflexfacility.com", "permanent": true },
    { "source": "/fuel/:path((?!agent(?:/|$)).*)", "destination": "https://fuel.theflexfacility.com", "permanent": true },
    { "source": "/fuel.html", "destination": "https://fuel.theflexfacility.com", "permanent": true }
  ]
}