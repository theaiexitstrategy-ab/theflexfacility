# Flex Fuel (TEST) — /fuel and /api/fuel/estimate
# Copy to .env.local for `vercel dev`. Never commit real values.

# Anthropic API key. Server-only; never sent to the browser.
ANTHROPIC_API_KEY=

# Optional. Defaults to claude-sonnet-5-5.
ANTHROPIC_MODEL=claude-sonnet-5-5

# Shared access code Coach Kenny and Aaron type into /fuel once per device.
FLEX_FUEL_ACCESS_CODE=
